SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx
SUPABASE_STORAGE_BUCKET=instagram-media

# Quantos vídeos o servidor renderiza ao mesmo tempo.
# 2 vCPU: 2 | 4 vCPU: 3-4 | 8 vCPU: 6-8
RENDER_CONCURRENCY=4
RENDER_POLL_MS=1500
DELETE_RENDER_SOURCES=true

# auto = usa NVIDIA NVENC se a máquina tiver GPU; senão libx264 nativo.
FFMPEG_ENCODER=auto

# Limite interno para o MP4 final antes do upload ao Supabase (Free: use 40)
STORAGE_SAFE_OUTPUT_MB=40

# Intervalo para detectar botão Parar no painel
RENDER_CANCEL_POLL_MS=1000

# Scheduler de publicação (não exige chave nova; usa HMAC com SUPABASE_SECRET_KEY)
PUBLISH_QUEUE_URL=https://r31-studio-automadark.vercel.app/api/cron/publish
PUBLISH_POLL_MS=15000
